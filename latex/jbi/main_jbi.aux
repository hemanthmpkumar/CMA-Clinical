\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces NASA-TLX cognitive load subscales. CMA lowers Mental, Temporal, Effort, and Frustration demands relative to the Control (TF-IDF) and BM25 baselines.}}{17}{}\protected@file@percent }
\newlabel{fig:tlx}{{4}{17}{}{figure.4}{}}
