\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Time-to-correct-information by condition. CMA resolves the task in 98.1~s versus 118.2~s (Control) and 118.4~s (BM25).}}{16}{}\protected@file@percent }
