\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Continuum Memory Architecture (CMA) component overview. Session intent is encoded as SPD matrix representations. Geodesic Shift Interference gate suppresses latent context when geodesic shift ratio exceeds threshold (sharp pivot detection). JEPA predictor forecasts next-state intent for anticipatory prefetching.}}{23}{}\protected@file@percent }
\newlabel{fig:cma_components}{{8}{23}{}{figure.8}{}}
