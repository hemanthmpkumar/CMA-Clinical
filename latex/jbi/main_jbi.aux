\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean retrieval latency per query. CMA achieved a 22.3\% reduction (145.8~ms vs 187.7~ms, $p<0.001$, $d=-3.76$) via JEPA-driven prefetching.}}{16}{}\protected@file@percent }
