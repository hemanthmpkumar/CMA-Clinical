\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ablation of GDT components on 31 paired vignettes. Values are mean percent change vs.\ TF-IDF control. Task completion was 0\% across all configurations.}}{12}{table.2}\protected@file@percent }
\newlabel{tab:ablation}{{2}{12}{Ablation of GDT components on 31 paired vignettes. Values are mean percent change vs.\ TF-IDF control. Task completion was 0\% across all configurations}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Component-wise ablation study across three outcomes: (a) system latency (\% reduction), (b) simulated cognitive load (\% change), and (c) time-to-correct-information (\% change vs.\ TF-IDF control). JEPA prefetching drives the primary latency reduction ($-22.2\%$ to $-26.9\%$). Confidence scaling (Full GDT vs.\ CMA) contributes an additional 4.7\% latency reduction. GSI gate alone has negligible latency and cognitive load impact ($-0.50\%$ and $-0.30\%$), but triggers on 34.7\% of transitions. Time-to-information remains within ${\pm }0.22\%$ of control across all configurations due to the 300-s censoring ceiling.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:ablation}{{3}{12}{Component-wise ablation study across three outcomes: (a) system latency (\% reduction), (b) simulated cognitive load (\% change), and (c) time-to-correct-information (\% change vs.\ TF-IDF control). JEPA prefetching drives the primary latency reduction ($-22.2\%$ to $-26.9\%$). Confidence scaling (Full GDT vs.\ CMA) contributes an additional 4.7\% latency reduction. GSI gate alone has negligible latency and cognitive load impact ($-0.50\%$ and $-0.30\%$), but triggers on 34.7\% of transitions. Time-to-information remains within ${\pm }0.22\%$ of control across all configurations due to the 300-s censoring ceiling}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Scaling Study}{13}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Latency scaling across session scales for all four arms. GDT maintains the lowest latency across scales. Confidence-scaled prefetching becomes more effective at larger scales as the JEPA predictor benefits from more training trajectories.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:scaling}{{4}{13}{Latency scaling across session scales for all four arms. GDT maintains the lowest latency across scales. Confidence-scaled prefetching becomes more effective at larger scales as the JEPA predictor benefits from more training trajectories}{figure.4}{}}
