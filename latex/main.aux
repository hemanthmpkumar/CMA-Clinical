\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean retrieval latency per query across the four arms. GDT (138.2~ms) reduced latency by 26.9\% vs.\ TF-IDF control ($p<0.001$, $d=-4.12$) and by 4.0\% vs.\ CMA ($p<0.001$, $d=-0.87$). TF-IDF and BM25 were statistically indistinguishable ($p=0.68$). The incremental GDT--CMA gap reflects confidence-scaled prefetching.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:latency}{{2}{10}{Mean retrieval latency per query across the four arms. GDT (138.2~ms) reduced latency by 26.9\% vs.\ TF-IDF control ($p<0.001$, $d=-4.12$) and by 4.0\% vs.\ CMA ($p<0.001$, $d=-0.87$). TF-IDF and BM25 were statistically indistinguishable ($p=0.68$). The incremental GDT--CMA gap reflects confidence-scaled prefetching}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Summary of secondary outcomes across the four arms. Comparisons are GDT vs.\ each benchmark. $^*p<0.05$; $^{**}p<0.01$; $^{***}p<0.001$.}}{11}{table.1}\protected@file@percent }
\newlabel{tab:secondary}{{1}{11}{Summary of secondary outcomes across the four arms. Comparisons are GDT vs.\ each benchmark. $^*p<0.05$; $^{**}p<0.01$; $^{***}p<0.001$}{table.1}{}}
