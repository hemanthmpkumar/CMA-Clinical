\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cumulative scaling study results across session scales (10, 100, 1{,}000) for all four arms: time-to-correct-information, cognitive load, latency, and queries. GDT (purple) maintains the lowest values on all metrics; the advantage persists and grows as the corpus and cohort scale.}}{16}{figure.6}\protected@file@percent }
\newlabel{fig:scaling_trends}{{6}{16}{Cumulative scaling study results across session scales (10, 100, 1{,}000) for all four arms: time-to-correct-information, cognitive load, latency, and queries. GDT (purple) maintains the lowest values on all metrics; the advantage persists and grows as the corpus and cohort scale}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Percentage change versus the TF-IDF control for BM25, CMA, and GDT across session scales. GDT's advantage on time-to-information, cognitive load, and latency is monotonically maintained as the scale grows.}}{16}{figure.7}\protected@file@percent }
\newlabel{fig:scaling_pct_change}{{7}{16}{Percentage change versus the TF-IDF control for BM25, CMA, and GDT across session scales. GDT's advantage on time-to-information, cognitive load, and latency is monotonically maintained as the scale grows}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Task accuracy per arm across session scales. GDT achieves the highest completion at every scale; the gap over the TF-IDF control widens at larger scales.}}{17}{figure.8}\protected@file@percent }
\newlabel{fig:scaling_accuracy}{{8}{17}{Task accuracy per arm across session scales. GDT achieves the highest completion at every scale; the gap over the TF-IDF control widens at larger scales}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Four-arm component ablation at scale 1{,}000. Removing the GSI gate (JEPA-only) raises time-to-information and lowers completion; disabling prefetch (GSI-only) leaves metrics near Full GDT. GDT remains fastest and most accurate in every configuration.}}{17}{figure.9}\protected@file@percent }
\newlabel{fig:ablation}{{9}{17}{Four-arm component ablation at scale 1{,}000. Removing the GSI gate (JEPA-only) raises time-to-information and lowers completion; disabling prefetch (GSI-only) leaves metrics near Full GDT. GDT remains fastest and most accurate in every configuration}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Geodesic intent trajectories on the SPD manifold $\mathcal  {S}_d^+$. The Control condition accumulates stale context across topic pivots; GDT with the Geodesic Shift Interference (GSI) gate suppresses stale context at large geodesic shifts, and the optimal-control prefetch engine forecasts next-intent embeddings. Larger benefit for multi-pivot tasks confirms the mechanism.}}{18}{figure.10}\protected@file@percent }
\newlabel{fig:intent_trajectory}{{10}{18}{Geodesic intent trajectories on the SPD manifold $\mathcal {S}_d^+$. The Control condition accumulates stale context across topic pivots; GDT with the Geodesic Shift Interference (GSI) gate suppresses stale context at large geodesic shifts, and the optimal-control prefetch engine forecasts next-intent embeddings. Larger benefit for multi-pivot tasks confirms the mechanism}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Geodesic Diagnostic Trajectories (GDT) component overview. Diagnostic intent is encoded as SPD matrix representations on $\mathcal  {S}_d^+$; the Geodesic Shift Interference gate suppresses stale context when the geodesic shift ratio exceeds threshold (sharp pivot detection); the JEPA-driven optimal-control prefetch engine forecasts next-state intent for anticipatory retrieval.}}{18}{figure.11}\protected@file@percent }
\newlabel{fig:cma_components}{{11}{18}{Geodesic Diagnostic Trajectories (GDT) component overview. Diagnostic intent is encoded as SPD matrix representations on $\mathcal {S}_d^+$; the Geodesic Shift Interference gate suppresses stale context when the geodesic shift ratio exceeds threshold (sharp pivot detection); the JEPA-driven optimal-control prefetch engine forecasts next-state intent for anticipatory retrieval}{figure.11}{}}
