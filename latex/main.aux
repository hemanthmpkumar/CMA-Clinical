\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Scaling study results (means; time columns in seconds). Time $\Delta $\% , latency $\Delta $\% and cognitive-load $\Delta $\% are GDT versus control; completion is the GDT task completion rate; $p$ and Cohen's $d$ are from Wilcoxon signed-rank tests on GDT--control pairs. ``Pooled'' combines all three scales (3{,}330 sessions per condition).}}{15}{table.1}\protected@file@percent }
\newlabel{tab:scaling}{{1}{15}{Scaling study results (means; time columns in seconds). Time $\Delta $\% , latency $\Delta $\% and cognitive-load $\Delta $\% are GDT versus control; completion is the GDT task completion rate; $p$ and Cohen's $d$ are from Wilcoxon signed-rank tests on GDT--control pairs. ``Pooled'' combines all three scales (3{,}330 sessions per condition)}{table.1}{}}
