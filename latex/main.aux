\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces GDT system architecture. Query embeddings are projected to the SPD manifold $\mathcal  {S}_d^+$. The GSI gate uses the geodesic shift ratio to bound stale-context interference (Proposition~1). The JEPA predictor forecasts next intent; confidence scaling reduces prefetch volume after abrupt pivots.}}{16}{figure.5}\protected@file@percent }
\newlabel{fig:cma_components}{{5}{16}{GDT system architecture. Query embeddings are projected to the SPD manifold $\mathcal {S}_d^+$. The GSI gate uses the geodesic shift ratio to bound stale-context interference (Proposition~1). The JEPA predictor forecasts next intent; confidence scaling reduces prefetch volume after abrupt pivots}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Operational Implications}{16}{subsection.5.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Diagnostic trajectory on $\mathcal  {S}_d^+$. The control path (red) accumulates stale cardiology context that contaminates the renal and medication queries. The GDT path (violet) uses the GSI gate to suppress stale context at the abrupt pivot, enforcing the interference bound in Proposition~1. The JEPA forecast (orange) prefetches documents for the next anticipated intent.}}{17}{figure.6}\protected@file@percent }
\newlabel{fig:intent_trajectory}{{6}{17}{Diagnostic trajectory on $\mathcal {S}_d^+$. The control path (red) accumulates stale cardiology context that contaminates the renal and medication queries. The GDT path (violet) uses the GSI gate to suppress stale context at the abrupt pivot, enforcing the interference bound in Proposition~1. The JEPA forecast (orange) prefetches documents for the next anticipated intent}{figure.6}{}}
