\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Benchmark flow for the four-arm crossover evaluation. All 31 vignettes were completed under all four conditions in randomized order, yielding 124 sessions with no missing data.}}{10}{figure.1}\protected@file@percent }
